# ========================================
# 传智健康管理系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ========================================

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=health_management
DB_USER=root
DB_PASSWORD=请填写MySQL密码

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 智能助手 (LLM) — Spring AI OpenAI 兼容（DeepSeek）
LLM_API_KEY=请填写助手API Key
LLM_MODEL=deepseek-chat
# 根地址，注意不带 /v1（Spring AI 会自行拼接 /v1/chat/completions）
LLM_BASE_URL_ROOT=https://api.deepseek.com

# 应用
SPRING_PROFILES_ACTIVE=dev
